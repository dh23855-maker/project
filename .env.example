# 이 파일을 복사해서 `.env`를 만들고 값을 채우세요. `.env`는 Git에 올라가지 않습니다.
# 이 파일(.env.example)에는 비밀값을 절대 적지 마세요.

# Supabase 접속 주소 (PostgreSQL). Supabase 프로젝트 > Connect 에서 복사
DATABASE_URL=

# OpenAI API 키 (초안 작성에 사용)
OPENAI_API_KEY=

# 초안 작성에 쓸 OpenAI 모델 이름 (Phase 3 시작 직전에 정함)
OPENAI_MODEL=

# 로그인 정보를 서명할 때 쓰는 임의의 긴 문자열 (아무 값이나 길게)
SESSION_SECRET=

# 화면 주소 (서버가 어느 화면에서 오는 요청을 허용할지)
FRONTEND_ORIGIN=http://localhost:5173
